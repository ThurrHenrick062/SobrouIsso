<file path="sobrouisso-app/context/AuthContext.tsx">
// context/AuthContext.tsx
// Guarda quem está logado. Também salva a sessão no celular (AsyncStorage)
// para o usuário não precisar fazer login toda vez que abrir o app.
//
// Nota de segurança: AsyncStorage é simples e ótimo para aprender. Em um app
// publicado, o ideal é guardar o token no expo-secure-store (armazenamento
// criptografado).

import AsyncStorage from "@react-native-async-storage/async-storage";
import { createContext, useContext, useEffect, useState, type ReactNode } from "react";
import { api, definirToken } from "@/services/api";
import { definirAoSessaoExpirar } from "@/services/sessao";
import type { DadosPerfil, RespostaAuth } from "@/types";

const CHAVE = "@sobrouisso:sessao";

interface AuthValor {
  usuario: RespostaAuth["usuario"] | null;
  carregando: boolean; // true enquanto lê a sessão salva ao abrir o app
  entrar(email: string, senha: string): Promise<void>;
  cadastrar(nome: string, email: string, senha: string): Promise<void>;
  atualizarPerfil(dados: DadosPerfil): Promise<void>;
  sair(): Promise<void>;
}

const AuthContext = createContext<AuthValor | null>(null);

export function AuthProvider({ children }: { children: ReactNode }) {
  const [sessao, setSessao] = useState<RespostaAuth | null>(null);
  const [carregando, setCarregando] = useState(true);

  // Ao abrir o app: existe uma sessão salva? Se sim, já entra logado.
  useEffect(() => {
    async function restaurarSessao() {
      try {
        const salva = await AsyncStorage.getItem(CHAVE);
        if (salva) {
          const dados: RespostaAuth = JSON.parse(salva);
          definirToken(dados.token);
          setSessao(dados);
        }
      } catch {
        // sessão ilegível: segue como deslogado
      } finally {
        setCarregando(false);
      }
    }
    restaurarSessao();
  }, []);

  // Se o servidor disser que o token não vale mais (expirou, ou a conta foi
  // apagada), desloga na hora em vez de deixar o app "meio logado".
  useEffect(() => {
    definirAoSessaoExpirar(() => {
      definirToken(null);
      setSessao(null);
      AsyncStorage.removeItem(CHAVE).catch(() => {});
    });
  }, []);

  async function iniciarSessao(dados: RespostaAuth) {
    definirToken(dados.token);
    await AsyncStorage.setItem(CHAVE, JSON.stringify(dados));
    setSessao(dados);
  }

  async function entrar(email: string, senha: string) {
    await iniciarSessao(await api.login(email, senha));
  }

  async function cadastrar(nome: string, email: string, senha: string) {
    await iniciarSessao(await api.cadastrar(nome, email, senha));
  }

  async function atualizarPerfil(dados: DadosPerfil) {
    if (!sessao) return;
    const usuario = await api.atualizarPerfil(dados);
    await iniciarSessao({ token: sessao.token, usuario });
  }

  async function sair() {
    // Primeiro limpamos o login na memória: é isso que faz o app voltar
    // para a tela de entrada na hora, mesmo que o armazenamento falhe.
    definirToken(null);
    setSessao(null);
    // Depois apagamos a sessão salva no celular, para ela não voltar
    // na próxima vez que o app abrir.
    await AsyncStorage.removeItem(CHAVE).catch(() => {});
  }

  return (
    <AuthContext.Provider
      value={{ usuario: sessao?.usuario ?? null, carregando, entrar, cadastrar, atualizarPerfil, sair }}
    >
      {children}
    </AuthContext.Provider>
  );
}

export function useAuth() {
  const contexto = useContext(AuthContext);
  if (!contexto) throw new Error("useAuth precisa estar dentro de <AuthProvider>");
  return contexto;
}
</file>

<file path="sobrouisso-app/context/ReceitasContext.tsx">
// context/ReceitasContext.tsx
// Guarda a lista de receitas do usuário (recentes e favoritas saem dela).
// Assim a Home, a tela de detalhe, os Favoritos e os Recentes enxergam
// sempre os mesmos dados, sem precisar buscar tudo de novo a cada tela.

import { createContext, useCallback, useContext, useEffect, useState, type ReactNode } from "react";
import { api } from "@/services/api";
import type { Receita } from "@/types";
import { useAuth } from "./AuthContext";

interface ReceitasValor {
  receitas: Receita[];
  carregando: boolean;
  recarregar(): Promise<void>;
  buscarReceita(ingredientes: string[]): Promise<Receita>;
  alternarFavorito(id: number): Promise<void>;
}

const ReceitasContext = createContext<ReceitasValor | null>(null);

export function ReceitasProvider({ children }: { children: ReactNode }) {
  const { usuario } = useAuth();
  const logado = usuario !== null;

  const [receitas, setReceitas] = useState<Receita[]>([]);
  const [carregando, setCarregando] = useState(false);

  const recarregar = useCallback(async () => {
    setCarregando(true);
    try {
      setReceitas(await api.listarReceitas());
    } catch {
      // Falhou? Mantém a lista que já estava na tela.
    } finally {
      setCarregando(false);
    }
  }, []);

  // Entrou na conta? Carrega o histórico. Saiu? Limpa a lista.
  useEffect(() => {
    if (logado) recarregar();
    else setReceitas([]);
  }, [logado, recarregar]);

  async function buscarReceita(ingredientes: string[]) {
    const nova = await api.buscarReceita(ingredientes);
    setReceitas((lista) => [nova, ...lista]);
    return nova;
  }

  async function alternarFavorito(id: number) {
    const atual = receitas.find((r) => r.id === id);
    if (!atual) return;
    const atualizada = await api.definirFavorito(id, !atual.favorito);
    setReceitas((lista) => lista.map((r) => (r.id === id ? atualizada : r)));
  }

  return (
    <ReceitasContext.Provider value={{ receitas, carregando, recarregar, buscarReceita, alternarFavorito }}>
      {children}
    </ReceitasContext.Provider>
  );
}

export function useReceitas() {
  const contexto = useContext(ReceitasContext);
  if (!contexto) throw new Error("useReceitas precisa estar dentro de <ReceitasProvider>");
  return contexto;
}
</file>

<file path="sobrouisso-app/context/TemaContext.tsx">
// context/TemaContext.tsx
// Context = uma "caixa" de dados que qualquer tela consegue ler sem precisar
// passar props de componente em componente. Aqui a caixa guarda o tema.

import AsyncStorage from "@react-native-async-storage/async-storage";
import { createContext, useContext, useEffect, useState, type ReactNode } from "react";
import { useColorScheme } from "react-native";
import { temas, type Cores, type NomeTema } from "@/constants/temas";

const CHAVE = "@sobrouisso:tema";

interface TemaValor {
  tema: NomeTema;
  cores: Cores;
  definirTema(novo: NomeTema): Promise<void>;
}

const TemaContext = createContext<TemaValor | null>(null);

export function TemaProvider({ children }: { children: ReactNode }) {
  const temaDoSistema = useColorScheme(); // "light" | "dark" | null
  const [escolhido, setEscolhido] = useState<NomeTema | null>(null);

  // Ao abrir o app, recupera o tema que o usuário escolheu da última vez.
  useEffect(() => {
    AsyncStorage.getItem(CHAVE)
      .then((valor) => {
        if (valor === "claro" || valor === "escuro") setEscolhido(valor);
      })
      .catch(() => {});
  }, []);

  // Sem escolha salva, segue o tema do celular.
  const tema: NomeTema = escolhido ?? (temaDoSistema === "dark" ? "escuro" : "claro");

  async function definirTema(novo: NomeTema) {
    setEscolhido(novo);
    await AsyncStorage.setItem(CHAVE, novo).catch(() => {});
  }

  return (
    <TemaContext.Provider value={{ tema, cores: temas[tema], definirTema }}>
      {children}
    </TemaContext.Provider>
  );
}

// Hook = atalho para ler a caixa. Nas telas basta: const { cores } = useTema();
export function useTema() {
  const contexto = useContext(TemaContext);
  if (!contexto) throw new Error("useTema precisa estar dentro de <TemaProvider>");
  return contexto;
}
