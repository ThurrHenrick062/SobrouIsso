<file path="sobrouisso-app/services/api.ts">
// services/api.ts
// ÚNICO lugar do app que sabe falar com o servidor. As telas nunca chamam
// fetch diretamente: elas chamam "api.login(...)", "api.buscarReceita(...)".
// Se o endereço ou o formato mudar, você corrige em um arquivo só.

import { API_URL, USAR_MOCK_AUTH, USAR_MOCK_RECEITAS } from "@/constants/config";
import type { Api, Receita, RespostaAuth, Usuario } from "@/types";
import { apiMock } from "./mock";
import { avisarSessaoExpirada, obterToken } from "./sessao";

// O AuthContext importa daqui; reexportamos para manter esse caminho.
export { definirToken } from "./sessao";

// Transforma qualquer erro em uma mensagem amigável para mostrar na tela.
export function mensagemDeErro(erro: unknown, padrao = "Algo deu errado. Tente novamente.") {
  return erro instanceof Error ? erro.message : padrao;
}

// Função genérica que faz a chamada HTTP. O <T> diz qual formato de dado
// esperamos receber de volta.
async function requisicao<T>(
  metodo: "GET" | "POST" | "PUT" | "PATCH",
  caminho: string,
  corpo?: unknown,
  tempoLimiteMs = 15_000
): Promise<T> {
  const token = obterToken();
  let resposta: Response;

  // Sem tempo limite, um servidor inalcançável (IP errado, Wi-Fi diferente)
  // deixaria o app esperando "para sempre". O AbortController cancela o pedido.
  const controle = new AbortController();
  const cronometro = setTimeout(() => controle.abort(), tempoLimiteMs);

  try {
    resposta = await fetch(`${API_URL}${caminho}`, {
      signal: controle.signal,
      method: metodo,
      headers: {
        "Content-Type": "application/json",
        // Só envia o crachá se já estivermos logados.
        ...(token ? { Authorization: `Bearer ${token}` } : {}),
      },
      body: corpo ? JSON.stringify(corpo) : undefined,
    });
  } catch {
    // fetch só lança erro quando nem chegou ao servidor (sem rede, IP errado...)
    // ou quando o tempo limite estourou.
    throw new Error(
      controle.signal.aborted
        ? "O servidor não respondeu a tempo. Confira se ele está rodando e se o endereço em constants/config.ts está certo."
        : "Não foi possível conectar ao servidor. Confira se ele está rodando e se o endereço em constants/config.ts está certo."
    );
  } finally {
    clearTimeout(cronometro);
  }

  const dados = await resposta.json().catch(() => null);

  if (!resposta.ok) {
    // 401 COM token = o servidor não aceita mais a nossa sessão: desloga.
    // (Um 401 no login acontece SEM token, então não cai aqui.)
    if (resposta.status === 401 && token) avisarSessaoExpirada();

    // Combinamos que o servidor responde erros assim: { "erro": "mensagem" }
    throw new Error(dados?.erro ?? "Algo deu errado. Tente novamente.");
  }

  return dados as T;
}

const apiReal: Api = {
  login: (email, senha) => requisicao<RespostaAuth>("POST", "/auth/login", { email, senha }),

  cadastrar: (nome, email, senha) =>
    requisicao<RespostaAuth>("POST", "/auth/cadastro", { nome, email, senha }),

  atualizarPerfil: (dados) => requisicao<Usuario>("PUT", "/usuarios/me", dados),

  // A IA leva alguns segundos para criar a receita: damos até 60s (o servidor
  // desiste sozinho aos 45s e responde com um aviso).
  buscarReceita: (ingredientes) =>
    requisicao<Receita>("POST", "/receitas/buscar", { ingredientes }, 60_000),

  listarReceitas: () => requisicao<Receita[]>("GET", "/receitas"),

  definirFavorito: (id, favorito) =>
    requisicao<Receita>("PATCH", `/receitas/${id}/favorito`, { favorito }),
};

// O app inteiro usa este "api". Cada grupo de funções vem do servidor real
// ou do mock, conforme as chaves em constants/config.ts.
const auth = USAR_MOCK_AUTH ? apiMock : apiReal;
const receitas = USAR_MOCK_RECEITAS ? apiMock : apiReal;

export const api: Api = {
  login: auth.login,
  cadastrar: auth.cadastrar,
  atualizarPerfil: auth.atualizarPerfil,
  buscarReceita: receitas.buscarReceita,
  listarReceitas: receitas.listarReceitas,
  definirFavorito: receitas.definirFavorito,
};
</file>

<file path="sobrouisso-app/services/dialogos.ts">
// services/dialogos.ts
// Avisos e confirmações que funcionam no CELULAR e no NAVEGADOR.
//
// Por que isso existe? O Alert.alert do React Native não faz nada na versão
// web: o aviso simplesmente não aparece e os botões nunca são executados.
// Aqui escolhemos o jeito certo de acordo com a plataforma onde o app roda.

import { Alert, Platform } from "react-native";

// Mostra uma mensagem simples (equivalente a Alert.alert(titulo, mensagem)).
export function avisar(titulo: string, mensagem?: string) {
  if (Platform.OS === "web") {
    window.alert(mensagem ? `${titulo}\n\n${mensagem}` : titulo);
    return;
  }
  Alert.alert(titulo, mensagem);
}

// Pergunta "tem certeza?" e devolve true (confirmou) ou false (cancelou).
// Uso:  if (await confirmar("Sair", "Deseja sair?", "Sair")) { ... }
export function confirmar(
  titulo: string,
  mensagem: string,
  textoConfirmar = "Confirmar"
): Promise<boolean> {
  if (Platform.OS === "web") {
    return Promise.resolve(window.confirm(`${titulo}\n\n${mensagem}`));
  }

  // No celular, o Alert só avisa por callback; embrulhamos numa Promise
  // para poder usar await.
  return new Promise((resolve) => {
    Alert.alert(
      titulo,
      mensagem,
      [
        { text: "Cancelar", style: "cancel", onPress: () => resolve(false) },
        { text: textoConfirmar, style: "destructive", onPress: () => resolve(true) },
      ],
      { cancelable: true, onDismiss: () => resolve(false) }
    );
  });
}
</file>

<file path="sobrouisso-app/services/mock.ts">
// services/mock.ts
// Servidor FALSO que roda dentro do próprio app, para você desenvolver as
// telas sem depender do backend. Os dados ficam só na memória: ao fechar
// o app, tudo some (contas e receitas), o que é esperado em um mock.
//
// Mesmo sendo falso, ele segue as MESMAS regras do servidor real: não deixa
// cadastrar e-mail repetido e só aceita login de conta já cadastrada.

import type { Api, Receita, Usuario } from "@/types";
import { obterToken } from "./sessao";

// Simula o tempo de resposta de uma rede/IA.
const esperar = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));

interface ContaMock extends Usuario {
  senha: string; // no mock a senha fica em texto puro; o servidor real guarda só o hash
}

let contas: ContaMock[] = [];
let proximoIdConta = 1;
let contaAtualId: number | null = null;

// As receitas ficam separadas por sessão (pelo token), para um usuário
// nunca ver as receitas de outro.
const receitasPorSessao = new Map<string, Receita[]>();
let proximoIdReceita = 1;

function minhasReceitas(): Receita[] {
  return receitasPorSessao.get(obterToken() ?? "") ?? [];
}

function guardarReceitas(lista: Receita[]) {
  receitasPorSessao.set(obterToken() ?? "", lista);
}

// O que o app pode ver da conta (sem a senha).
function publico(conta: ContaMock): Usuario {
  return { id: conta.id, nome: conta.nome, email: conta.email, tema: conta.tema };
}

function emailEmUso(email: string, ignorarId?: number) {
  return contas.some((c) => c.email === email && c.id !== ignorarId);
}

export const apiMock: Api = {
  async login(email, senha) {
    await esperar(400);
    const conta = contas.find((c) => c.email === email.trim().toLowerCase());
    // Mesma mensagem para e-mail inexistente e senha errada, como no servidor.
    if (!conta || conta.senha !== senha) throw new Error("E-mail ou senha incorretos.");
    contaAtualId = conta.id;
    return { token: `mock-${conta.id}`, usuario: publico(conta) };
  },

  async cadastrar(nome, email, senha) {
    await esperar(400);
    const emailNormalizado = email.trim().toLowerCase();
    if (emailEmUso(emailNormalizado)) throw new Error("Este e-mail já está cadastrado.");

    const conta: ContaMock = {
      id: proximoIdConta++,
      nome: nome.trim(),
      email: emailNormalizado,
      senha,
      tema: "claro",
    };
    contas = [...contas, conta];
    contaAtualId = conta.id;
    return { token: `mock-${conta.id}`, usuario: publico(conta) };
  },

  async atualizarPerfil(dados) {
    await esperar(300);
    const conta = contas.find((c) => c.id === contaAtualId);
    if (!conta) throw new Error("Sua sessão expirou. Entre novamente.");

    const emailNormalizado = dados.email.trim().toLowerCase();
    if (emailEmUso(emailNormalizado, conta.id)) throw new Error("Este e-mail já está cadastrado.");

    const atualizada: ContaMock = {
      ...conta,
      nome: dados.nome.trim(),
      email: emailNormalizado,
      senha: dados.senha || conta.senha, // vazio = mantém a senha atual
    };
    contas = contas.map((c) => (c.id === conta.id ? atualizada : c));
    return publico(atualizada);
  },

  async buscarReceita(ingredientes) {
    await esperar(1500); // a IA real também demora alguns segundos

    const nova: Receita = {
      id: proximoIdReceita++,
      titulo: `Refogado de ${ingredientes[0]}`,
      descricao: "Uma receita simples e rápida, feita só com o que você já tem em casa.",
      tempoPreparo: "20 min",
      dificuldade: "Muito fácil",
      ingredientes: [
        ...ingredientes.map((item) => `${item} (quanto baste)`),
        "1 colher de sopa de óleo",
        "Sal a gosto",
      ],
      modoPreparo: [
        "Lave e pique todos os ingredientes em pedaços pequenos.",
        "Aqueça o óleo em uma panela em fogo médio.",
        "Adicione os ingredientes, começando pelos que demoram mais a cozinhar.",
        "Tempere com sal e mexa de vez em quando por cerca de 10 minutos.",
        "Prove, ajuste o tempero e sirva quente.",
      ],
      ingredientesBusca: ingredientes,
      favorito: false,
      criadoEm: new Date().toISOString(),
    };

    guardarReceitas([nova, ...minhasReceitas()]); // a mais nova vai para o começo
    return nova;
  },

  async listarReceitas() {
    await esperar(300);
    return minhasReceitas();
  },

  async definirFavorito(id, favorito) {
    await esperar(150);
    const existente = minhasReceitas().find((r) => r.id === id);
    if (!existente) throw new Error("Receita não encontrada.");
    const atualizada = { ...existente, favorito };
    guardarReceitas(minhasReceitas().map((r) => (r.id === id ? atualizada : r)));
    return atualizada;
  },
};
</file>

