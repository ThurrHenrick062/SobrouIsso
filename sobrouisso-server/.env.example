# Copie este arquivo para ".env" e preencha os valores:
#   cp .env.example .env        (Windows: copy .env.example .env)
#
# O arquivo .env NÃO vai para o GitHub (está no .gitignore).
# Este .env.example vai, para mostrar ao grupo quais variáveis existem.

# Porta em que o servidor vai rodar
PORT=3000

# Segredo usado para assinar os tokens de login (JWT). OBRIGATÓRIO.
# Quem souber este segredo consegue forjar logins, então use um texto longo e
# aleatório e não o compartilhe. Para gerar um, rode no terminal:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Chave da API do Google Gemini. OBRIGATÓRIA para buscar receitas com IA.
# 1) Entre em https://aistudio.google.com/apikey com a sua conta Google
# 2) Clique em "Criar chave de API" (o plano gratuito não pede cartão)
# 3) Cole a chave aqui, sem aspas e sem espaços. NUNCA compartilhe nem suba
#    esta chave para o GitHub (o .env já está no .gitignore).
GEMINI_API_KEY=

# Modelo da IA. Os modelos antigos são desativados com frequência; se aparecer
# "modelo não encontrado" no terminal do servidor, veja os modelos atuais em
# https://ai.google.dev/gemini-api/docs/models e troque aqui.
GEMINI_MODEL=gemini-3.5-flash-lite
